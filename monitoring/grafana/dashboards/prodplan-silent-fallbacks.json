  "description": "ProdPlan ONE — Silent fallback monitor (Sprint Q.13.F F.5). Each panel surfaces a `prodplan_silent_fallback_total{module,reason}` series — the metric every best-effort code path bumps when it swallows an error and returns a default. A non-zero rate means production is silently degrading. Pair with the alert rule `SilentFallbackRateHigh` in monitoring/prometheus/alerts.yml.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "liveNow": true,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Total fallbacks per module over the last 5 min. Spikes here mean a degraded path is firing — investigate the corresponding `reason` label.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "lineInterpolation": "linear", "barAlignment": 0, "lineWidth": 2, "fillOpacity": 20, "gradientMode": "opacity", "spanNulls": false, "showPoints": "auto", "pointSize": 5, "stacking": {"mode": "none"}},
          "unit": "short"
        }
      },
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 0},
      "id": 1,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum by (module) (rate(prodplan_silent_fallback_total[5m]))",
          "legendFormat": "{{module}}",
          "refId": "A"
        }
      ],
      "title": "Fallback rate per module",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Top 10 (module, reason) pairs in the last hour. Use this to triage which path is degrading most often.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 10}]},
          "unit": "short"
        }
      },
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 9},
      "id": 2,
      "options": {"showHeader": true, "footer": {"show": false}, "sortBy": [{"displayName": "Value", "desc": true}]},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "topk(10, sum by (module, reason) (increase(prodplan_silent_fallback_total[1h])))",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Top fallback (module, reason) — last 1h",
      "type": "table"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Total fallbacks the SLO budget allows per day vs actual. A ratio > 1.0 means the SLO is breached.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.5}, {"color": "red", "value": 1.0}]},
          "unit": "percentunit"
        }
      },
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 9},
      "id": 3,
      "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "orientation": "auto", "showThresholdLabels": false, "showThresholdMarkers": true},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(increase(prodplan_silent_fallback_total[24h])) / 100",
          "refId": "A"
        }
      ],
      "title": "SLO consumption (budget=100/day)",
      "type": "gauge"
    }
  ],
  "schemaVersion": 38,
  "style": "dark",
