{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "ProdPlan ONE — CPO scheduler performance (Sprint Q.13.F F.5). Latency + throughput of the heavy planning endpoints. Pair with the alert `CPOSchedulingLatencyP99High` in monitoring/prometheus/alerts.yml — the P99 should sit under 30s for normal workloads.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "liveNow": true,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "P50/P95/P99 latency for /v1/plan/cpo/* endpoints. Sustained P99 > 30s indicates the GA isn't converging or the surrogate is misconfigured.",
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "gradientMode": "opacity"}, "unit": "s"}
      },
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 0},
      "id": 1,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "histogram_quantile(0.50, sum by (le) (rate(prodplan_http_request_duration_seconds_bucket{path_template=~\"/v1/plan/cpo.*\"}[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "histogram_quantile(0.95, sum by (le) (rate(prodplan_http_request_duration_seconds_bucket{path_template=~\"/v1/plan/cpo.*\"}[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "histogram_quantile(0.99, sum by (le) (rate(prodplan_http_request_duration_seconds_bucket{path_template=~\"/v1/plan/cpo.*\"}[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "title": "CPO latency (p50 / p95 / p99)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Requests per second per CPO endpoint. Watch for traffic spikes that correlate with latency increases.",
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10}, "unit": "reqps"}
      },
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 9},
      "id": 2,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum by (path_template) (rate(prodplan_http_requests_total{path_template=~\"/v1/plan/cpo.*\"}[5m]))",
          "legendFormat": "{{path_template}}",
          "refId": "A"
        }
      ],
      "title": "CPO request rate (per endpoint)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Error ratio (status >= 5xx). Sustained > 1% triggers the alert and pages SRE.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.005}, {"color": "red", "value": 0.01}]},
          "unit": "percentunit"
        }
      },
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 9},
      "id": 3,
      "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"]}, "orientation": "auto", "showThresholdMarkers": true},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(rate(prodplan_http_requests_total{path_template=~\"/v1/plan/cpo.*\",status=~\"5..\"}[5m])) / sum(rate(prodplan_http_requests_total{path_template=~\"/v1/plan/cpo.*\"}[5m]))",
          "refId": "A"
        }
      ],
      "title": "CPO 5xx error ratio (last 5m)",
      "type": "gauge"
    }
  ],
