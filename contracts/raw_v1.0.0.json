{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://prodplan.io/schemas/factory-data-product/raw/v1.0.0",
  "title": "Factory Data Product - RAW Layer Schema",
  "description": "Schema for RAW layer data (Excel → RAW boundary)",
  "version": "1.0.0",
  "definitions": {
    "EntityId": {
      "type": "string",
      "description": "Entity ID - always string, never float",
      "pattern": "^[^.]+$|^[0-9]+$",
      "minLength": 1
    },
    "Timestamp": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "ISO 8601 timestamp with timezone"
    },
    "NonNegativeNumber": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "RawOrdemFabrico": {
      "type": "object",
      "required": ["of_id"],
      "properties": {
        "of_id": { "$ref": "#/definitions/EntityId" },
        "of_data_criacao": { "$ref": "#/definitions/Timestamp" },
        "of_data_acabamento": { "$ref": "#/definitions/Timestamp" },
        "of_data_transporte": { "$ref": "#/definitions/Timestamp" },
        "of_produto_id": { "type": ["string", "null"] },
        "of_fase_id": { "type": ["string", "null"] },
        "of_estado": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "RawFaseOrdemFabrico": {
      "type": "object",
      "required": ["fase_of_id", "fase_of_of_id"],
      "properties": {
        "fase_of_id": { "$ref": "#/definitions/EntityId" },
        "fase_of_of_id": { "$ref": "#/definitions/EntityId" },
        "fase_of_inicio": { "$ref": "#/definitions/Timestamp" },
        "fase_of_fim": { "$ref": "#/definitions/Timestamp" },
        "fase_of_data_prevista": { "$ref": "#/definitions/Timestamp" },
        "fase_of_coeficiente": { "$ref": "#/definitions/NonNegativeNumber" },
        "fase_of_coeficiente_x": { "$ref": "#/definitions/NonNegativeNumber" },
        "fase_of_fase_id": { "type": ["string", "null"] },
        "fase_of_peso": { "$ref": "#/definitions/NonNegativeNumber" },
        "fase_of_retorno": { "type": ["integer", "null"] },
        "fase_of_turno": { "type": ["string", "null"] },
        "fase_of_sequencia": { "type": ["integer", "null"] },
        "molde_of_id": { "type": ["string", "null"] },
        "molde_nome": { "type": ["string", "null"] },
        "molde_numero_pocos_id": { "type": ["string", "null"] },
        "molde_modelo_id": { "type": ["string", "null"] },
        "molde_tamanho_id": { "type": ["string", "null"] },
        "fase_of_horas_previstas": {
          "type": ["number", "null"],
          "description": "CRITICAL: 56.6% are 0 (semantic null)",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "RawFuncionario": {
      "type": "object",
      "required": ["funcionario_id"],
      "properties": {
        "funcionario_id": { "$ref": "#/definitions/EntityId" },
        "funcionario_nome": { "type": ["string", "null"] },
        "funcionario_activo": { "type": ["integer", "null"], "enum": [0, 1, null] },
        "funcionario_valor_hora": {
          "type": ["number", "null"],
          "description": "0 = invalid for cost calculations",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "RawFase": {
      "type": "object",
      "required": ["fase_id"],
      "properties": {
        "fase_id": { "$ref": "#/definitions/EntityId" },
        "fase_nome": { "type": ["string", "null"] },
        "fase_sequencia": { "type": ["integer", "null"] },
        "fase_producao": { "type": ["integer", "null"], "enum": [0, 1, null] },
        "fase_automatica": { "type": ["integer", "null"], "enum": [0, 1, null] },
        "fase_numero_funcionarios": { "type": ["integer", "null"], "minimum": 0 },
        "fase_capacidade_horas_dia": { "$ref": "#/definitions/NonNegativeNumber" }
      },
      "additionalProperties": false
    },
    "RawMolde": {
      "type": "object",
      "required": ["molde_id"],
      "properties": {
        "molde_id": { "$ref": "#/definitions/EntityId" },
        "molde_nome": { "type": ["string", "null"] },
        "molde_estado": { "type": ["string", "null"], "description": "Code without dictionary" },
        "molde_modelo": { "type": ["string", "null"] },
        "molde_numero_pocos_id": { "type": ["string", "null"] },
        "molde_modelo_id": { "type": ["string", "null"] },
        "molde_tamanho_id": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "RawFaseStandardModelo": {
      "type": "object",
      "required": ["produto_fase_produto_id", "produto_fase_fase_id"],
      "properties": {
        "produto_fase_produto_id": { "$ref": "#/definitions/EntityId" },
        "produto_fase_fase_id": { "$ref": "#/definitions/EntityId" },
        "produto_fase_sequencia": { "type": ["integer", "null"] },
        "produto_fase_coeficiente": { "$ref": "#/definitions/NonNegativeNumber" },
        "produto_fase_coeficiente_x": { "$ref": "#/definitions/NonNegativeNumber" },
        "produto_fase_horas_previstas": { "$ref": "#/definitions/NonNegativeNumber" }
      },
      "additionalProperties": false
    },
    "RawOrdemFabricoErro": {
      "type": "object",
      "required": ["erro_of_id"],
      "properties": {
        "erro_descricao": { "type": ["string", "null"] },
        "erro_of_id": { "$ref": "#/definitions/EntityId" },
        "erro_fase_avaliacao": { "type": ["string", "null"] },
        "ofch_gravidade": { "type": ["integer", "null"] },
        "erro_fase_of_avaliacao": { "type": ["string", "null"] },
        "erro_fase_of_culpada": {
          "type": ["string", "null"],
          "description": "41.5% are NULL"
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "ordens_fabrico": {
      "type": "array",
      "items": { "$ref": "#/definitions/RawOrdemFabrico" }
    },
    "fases_ordem_fabrico": {
      "type": "array",
      "items": { "$ref": "#/definitions/RawFaseOrdemFabrico" }
    },
    "funcionarios": {
      "type": "array",
      "items": { "$ref": "#/definitions/RawFuncionario" }
    },
    "fases": {
      "type": "array",
      "items": { "$ref": "#/definitions/RawFase" }
    },
    "moldes": {
      "type": "array",
      "items": { "$ref": "#/definitions/RawMolde" }
    },
    "fases_standard_modelos": {
      "type": "array",
      "items": { "$ref": "#/definitions/RawFaseStandardModelo" }
    },
    "ordem_fabrico_erros": {
      "type": "array",
      "items": { "$ref": "#/definitions/RawOrdemFabricoErro" }
    }
  }
}


