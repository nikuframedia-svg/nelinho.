# =============================================================================
# ProdPlan ONE — Configuração de PRODUÇÃO (fábrica NELO)
# =============================================================================
# Copia este ficheiro para /etc/prodplan/env na torre da fábrica e preenche
# os valores reais. O systemd lê-o via `EnvironmentFile=/etc/prodplan/env`.
#
#   NUNCA commitar o ficheiro preenchido — só este .example entra no git.
#   Gera o SECRET_KEY com:  openssl rand -hex 32
#
# Diferenças face ao dev (.env.example): ENVIRONMENT=production liga o RBAC
# estrito e o fail-closed do auth; DEBUG=false esconde tracebacks; os URLs
# apontam para a infra real da torre, não para localhost.
# =============================================================================

# --- Base de dados (OBRIGATÓRIO) ---------------------------------------------
DATABASE_URL=postgresql+asyncpg://prodplan:CHANGE_ME@localhost:5432/prodplan_one
POSTGRES_USER=prodplan
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=prodplan_one

# --- Segurança (OBRIGATÓRIO) -------------------------------------------------
# O arranque RECUSA um SECRET_KEY com marcadores de dev em ENVIRONMENT=production.
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Aplicação ---------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
# Origem do frontend servido pelo Caddy — o FQDN real da torre.
CORS_ORIGINS=https://pp1.nelo.local
# Hostname que o Caddy serve (ver deploy/Caddyfile {$PRODPLAN_HOST}).
PRODPLAN_HOST=pp1.nelo.local

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=CHANGE_ME

# --- Kafka (DESLIGADO em produção single-server) -----------------------------
# Deixar vazio — o padrão outbox (event_outbox + LISTEN/NOTIFY) chega para
# uma máquina. Só preencher se apontares para um broker externo.
# KAFKA_BOOTSTRAP_SERVERS=

# --- Ollama (LLM local — copiloto) -------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TEMPERATURE=0.1
OLLAMA_NUM_PREDICT=1024
COPILOT_EMBEDDINGS_MODEL=nomic-embed-text

# --- ERP NELO (SQL Server MAR-KAYAKS — adapter READ-ONLY) --------------------
# Liga o nelinho aos dados vivos do ERP. Requer o driver ODBC do SO instalado
# ("ODBC Driver 18 for SQL Server") + os pacotes aioodbc/pyodbc (requirements).
# A conta deve ser DataReader-only — o nelinho NUNCA escreve no ERP.
#
# Q.68.6.C: SQLSERVER_ENABLED arranca em `false` (no-op silencioso dos 10
# mirrors ETL). Para fazer o flip em produção, segue
# `agent_docs/erp_nelo_activation_checklist.md` — passos de network,
# driver ODBC, smoke `validate_nelo_erp.py`, primeiro sync manual,
# verificação de `core.etl_run`, rollback. NÃO flipar sem o checklist.
SQLSERVER_ENABLED=false
# SQLSERVER_URL=mssql+aioodbc://USER:CHANGE_ME@fabrica.nelo.eu:1039/MAR-KAYAKS?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes&Encrypt=no
SQLSERVER_POOL_SIZE=5
SQLSERVER_QUERY_TIMEOUT_S=30

# --- SMTP (OPCIONAL — relatórios por email) ----------------------------------
# Preencher só se quiseres os relatórios enviados por email (Q.22.F).
# SMTP_ENABLED=true
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# --- Observabilidade (OPCIONAL) ----------------------------------------------
# OTel e Sentry fazem no-op se as vars ficarem por definir. Ver .env.example.
# SENTRY_DSN=
# OTEL_TRACES_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_ENDPOINT=
