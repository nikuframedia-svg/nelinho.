{
  "annotations": { "list": [] },
  "description": "Q.61.38 — painel Direcao: KPIs operacionais do nelinho (outbox, kafka, latencia HTTP, sub-sistemas degradados).",
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 200 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "title": "Outbox pending (atual)",
      "targets": [
        {
          "expr": "prodplan_outbox_pending_total",
          "legendFormat": "pending"
        }
      ],
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "Outbox events dispatched (rate / 5m)",
      "targets": [
        {
          "expr": "sum by (status) (rate(prodplan_outbox_events_dispatched_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "Kafka publishes — failures",
      "targets": [
        {
          "expr": "sum by (topic) (rate(prodplan_kafka_producer_failure_total[5m]))",
          "legendFormat": "{{topic}}"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "HTTP 5xx rate (1m)",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{code=~\"5..\"}[1m]))",
          "legendFormat": "5xx"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 5,
      "title": "HTTP request duration p95/p99 (s)",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 6,
      "title": "Outbox dispatcher latency (s) — histogram",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(prodplan_outbox_dispatcher_latency_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ],
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["nelinho", "direcao", "q61"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "Europe/Lisbon",
  "title": "Direcao — nelinho ops",
  "uid": "nelinho-direcao-q61",
  "version": 1
}
