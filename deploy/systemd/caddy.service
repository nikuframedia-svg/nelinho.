[Unit]
Description=Caddy — reverse proxy / TLS terminator para o ProdPlan ONE
Documentation=https://caddyserver.com/docs/
# O Caddy só faz sentido depois da rede; arranca a API à parte (não é
# Requires= de propósito — o Caddy deve subir e devolver 502 enquanto a
# API ainda não está pronta, em vez de falhar em cadeia).
After=network-online.target prodplan-api.service
Wants=network-online.target

[Service]
Type=notify
User=caddy
Group=caddy

# O Caddyfile vive no repositório clonado; o env define PRODPLAN_HOST.
# Mantém o mesmo EnvironmentFile da API para partilhar PRODPLAN_HOST.
EnvironmentFile=/etc/prodplan/env

# Valida o Caddyfile antes de arrancar — falha cedo se a config estiver má.
ExecStartPre=/usr/bin/caddy validate --config /opt/prodplan/deploy/Caddyfile
ExecStart=/usr/bin/caddy run --environ --config /opt/prodplan/deploy/Caddyfile
# `systemctl reload caddy` recarrega sem largar ligações.
ExecReload=/usr/bin/caddy reload --config /opt/prodplan/deploy/Caddyfile --force

Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=120
StartLimitBurst=5

# Hardening — mesmo princípio de menor privilégio do prodplan-api.service.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true

# O Caddy precisa de ligar a :80/:443 sem correr como root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Escreve só ao log e ao store de certificados (ACME / CA interna).
ReadWritePaths=/var/log/prodplan /var/lib/caddy
Environment=XDG_DATA_HOME=/var/lib/caddy

# Logging para journald — `journalctl -u caddy`.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=caddy

[Install]
WantedBy=multi-user.target
