# =============================================================================
# ProdPlan ONE - Environment Configuration
# =============================================================================
# Copy this file to .env and configure your values.
# DO NOT commit .env to version control!
#
# Production (Nelo server) deploys via `deploy/install.sh` and writes
# /etc/prodplan/env directly — this file is for local dev. All URLs
# default to localhost; works the same for dev docker-compose (Postgres
# + Redis only) and native installs.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (REQUIRED in production)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://prodplan:your_password_here@localhost:5432/prodplan_one
POSTGRES_USER=prodplan
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=prodplan_one

# -----------------------------------------------------------------------------
# Security (REQUIRED in production)
# -----------------------------------------------------------------------------
SECRET_KEY=generate-a-strong-random-key-with-openssl-rand-hex-64
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=your_redis_password_here

# -----------------------------------------------------------------------------
# Kafka (OPTIONAL — deprecated on single-server deployments)
# -----------------------------------------------------------------------------
# Native deployments on the Nelo server do NOT run Kafka. The transactional
# outbox pattern (event_outbox table + LISTEN/NOTIFY) covers the events we
# need on one machine. Leave KAFKA_BOOTSTRAP_SERVERS empty to disable the
# aiokafka client entirely. Set it only when you're pointing at an external
# broker (multi-tenant cluster, cross-site replication).
# KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# -----------------------------------------------------------------------------
# Ollama (Local LLM)
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TEMPERATURE=0.1
OLLAMA_NUM_PREDICT=1024
COPILOT_EMBEDDINGS_MODEL=nomic-embed-text

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------------
# Observability — OpenTelemetry tracing (Sprint Q.13.B / B1)
# -----------------------------------------------------------------------------
# Both the OTel SDK and Sentry SDK gracefully no-op when their env vars are
# unset OR their optional deps aren't installed. The deploy contract:
#
#   1. Install the optional deps (see requirements.txt comment block).
#   2. Set the env vars below to point at your collector / DSN.
#
# Local validation without a collector: set OTEL_TRACES_EXPORTER=console
# and OTel will print spans to stdout — useful to confirm wiring before
# deploying. Set OTEL_TRACES_EXPORTER=none (or leave unset) to disable.
#
# OTEL_TRACES_EXPORTER=otlp           # otlp / console / none (default unset = off)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# OTEL_SERVICE_NAME=prodplan-api
# OTEL_SDK_DISABLED=false             # set true to force-disable
# PRODPLAN_VERSION=1.0.0              # surfaces as service.version in spans

# -----------------------------------------------------------------------------
# Observability — Sentry error reporting (Sprint Q.13.F / F.4)
# -----------------------------------------------------------------------------
# Leave SENTRY_DSN unset to disable. When set, every unhandled exception in
# FastAPI / Starlette is captured + tagged with the release. Request bodies
# are scrubbed by default (Copilot conversations may contain factory-internal
# references — see _scrub_event in src/shared/error_reporting.py).
#
# SENTRY_DSN=https://<key>@<orgid>.ingest.sentry.io/<projectid>
# SENTRY_ENABLED=true                 # set false to disable even with DSN set
# SENTRY_TRACES_SAMPLE_RATE=0.1       # 0.0-1.0 — fraction of requests traced
