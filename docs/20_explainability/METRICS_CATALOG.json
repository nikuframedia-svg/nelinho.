  "metrics": [
    {
      "metric_id": "lead_time_teorico_dias",
      "name": "Lead Time Teórico (Dias)",
      "domain": "factory",
      "category": "performance",
      "definition": "Diferença entre data de conclusão e data de entrada de uma ordem de fabrico",
      "formula": "data_conclusao - data_entrada",
      "unit": "days",
      "sources": [
        {"schema": "factory_curated", "table_or_view": "order", "fields": ["data_entrada", "data_conclusao"]}
      ],
      "parameters": {
        "of_id": {"type": "string", "required": false, "description": "Filtrar por ordem"},
        "produto_id": {"type": "string", "required": false, "description": "Filtrar por produto"}
      },
      "trust_base": 70,
      "assumptions": [
        "Datas registadas no sistema estão correctas",
        "Não inclui tempos de espera não registados"
      ],
      "forbidden_claims": [
        "Não usar como OTD real",
        "Não representa lead time industrial completo"
      ],
      "how_to_improve": [
        "Garantir registo de data_entrada em todas as ordens",
        "Garantir registo de data_conclusao quando fechado"
      ],
      "blocked": false
    },
    {
      "metric_id": "backlog_horas_teoricas",
      "name": "Backlog Teórico (Horas)",
      "domain": "factory",
      "category": "capacity",
      "definition": "Soma das horas teóricas das fases pendentes",
      "formula": "SUM(horas_finais) WHERE estado NOT IN ('Concluido', 'Fechado')",
      "unit": "hours",
      "sources": [
        {"schema": "factory_curated", "table_or_view": "order_phase", "fields": ["horas_finais", "estado"]}
      ],
      "parameters": {
        "fase_id": {"type": "string", "required": false, "description": "Filtrar por fase"}
      },
      "trust_base": 50,
      "assumptions": [
        "horas_finais = COALESCE(horas_previstas, horas_standard)",
        "Fases sem horas assumem 0",
        "Capacidade não considera variabilidade"
      ],
      "forbidden_claims": [
        "Não representa carga real de trabalho",
        "Não usar para OEE",
        "Não usar para planeamento detalhado"
      ],
      "how_to_improve": [
        "Preencher FaseOf_HorasPrevistas para todas as fases",
        "Validar StandardHoras no cadastro de modelos",
        "Implementar registo de horas reais"
      ],
      "blocked": false
    },
    {
      "metric_id": "utilizacao_teorica_pct",
      "name": "Utilização Teórica (%)",
      "domain": "factory",
      "category": "capacity",
      "definition": "Razão entre carga teórica e capacidade disponível por fase",
      "formula": "(SUM(horas_finais) / capacidade_horas) * 100",
      "unit": "pct",
      "sources": [
        {"schema": "factory_curated", "table_or_view": "order_phase", "fields": ["horas_finais"]},
        {"schema": "factory_curated", "table_or_view": "phase_capacity", "fields": ["capacidade_horas"]}
      ],
      "parameters": {
        "fase_id": {"type": "string", "required": false, "description": "Filtrar por fase"}
      },
      "trust_base": 40,
      "assumptions": [
        "Capacidade é constante (não considera turnos, absentismo)",
        "Carga baseada em standards teóricos"
      ],
      "forbidden_claims": [
        "NÃO é OEE",
        "NÃO representa utilização real",
        "Não usar para decisões operacionais críticas"
      ],
      "how_to_improve": [
        "Implementar registo de capacidade real por período",
        "Registar paragens e absentismo",
        "Implementar MES para dados reais"
      ],
      "blocked": false
    },
    {
      "metric_id": "bottleneck_score",
      "name": "Score de Bottleneck Teórico",
      "domain": "factory",
      "category": "capacity",
      "definition": "Indicador de estrangulamento potencial por fase",
      "formula": "CASE WHEN utilizacao_teorica > 120 THEN 'high' WHEN utilizacao_teorica > 80 THEN 'medium' ELSE 'low' END",
      "unit": "category",
      "sources": [
        {"schema": "factory_semantic", "table_or_view": "v_bottlenecks_teoricos", "fields": ["utilizacao_pct"]}
      ],
      "parameters": {
        "fase_id": {"type": "string", "required": false, "description": "Filtrar por fase"}
      },
      "trust_base": 40,
      "assumptions": [
        "Baseado em utilização teórica",
        "Threshold de 120% e 80% são heurísticos"
      ],
      "forbidden_claims": [
        "Não confirma bottleneck real",
        "Requer validação com dados de produção"
      ],
      "how_to_improve": [
        "Validar thresholds com equipa de produção",
        "Implementar análise de WIP real"
      ],
      "blocked": false
    },
    {
      "metric_id": "mold_conflicts_count",
      "name": "Conflitos de Moldes Potenciais",
      "domain": "factory",
      "category": "scheduling",
      "definition": "Contagem de moldes com múltiplas atribuições sobrepostas",
      "formula": "COUNT(DISTINCT molde_id) WHERE ofs_afetados > 1",
      "unit": "count",
      "sources": [
