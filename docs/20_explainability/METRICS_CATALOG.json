    {
      "metric_id": "skill_risk_level",
      "name": "Risco de Competências",
      "domain": "hr",
      "category": "skills",
      "definition": "Nível de risco por concentração de competências numa fase",
      "formula": "CASE WHEN aptos_count = 0 THEN 'critical' WHEN aptos_count = 1 THEN 'high' WHEN aptos_count <= 3 THEN 'medium' ELSE 'low' END",
