      "trust_base": 60,
      "assumptions": [
        "Conflito detectado por sobreposição de datas planeadas",
        "Não considera tempo real de ocupação"
      ],
      "forbidden_claims": [
        "Não confirma conflito efectivo",
        "Pode haver resolução manual não registada"
      ],
      "how_to_improve": [
        "Registar ocupação real de moldes",
        "Implementar calendário de moldes"
      ],
      "blocked": false
    },
    {
      "metric_id": "quality_error_rate_pct",
      "name": "Taxa de Erros de Qualidade (%)",
      "domain": "quality",
      "category": "quality",
      "definition": "Percentagem de erros por fase ou molde",
